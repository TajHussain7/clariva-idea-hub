# Database Configuration
# Replace with your PostgreSQL or Supabase connection string.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Port for the backend API server
PORT=3000

# Express Session Secret — use a strong random string in production
SESSION_SECRET=change-this-to-a-long-random-secret

# Allowed CORS Origins — comma-separated list of allowed frontend URLs
# In production: set this to your Vercel deployment URL
# e.g. CORS_ORIGIN=https://clariva-idea-hub-clariva-web.vercel.app
CORS_ORIGIN=http://localhost:5173

# Logging Level
LOG_LEVEL=info

# AI Integrations - OpenRouter Configuration
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Slot 2 — Upgrade to Gemini 2.5 Flash (free on OpenRouter)
# Get key at: openrouter.ai/keys (same key as slot 1 is fine)
AI_INTEGRATIONS_OPENROUTER_API_KEY_2=your_openrouter_api_key_here
AI_INTEGRATIONS_OPENROUTER_MODEL_2=google/gemini-2.5-flash-preview:free

# AI Slot 3 — DeepSeek R1 for deep reasoning (free on OpenRouter)
AI_INTEGRATIONS_OPENROUTER_API_KEY_3=your_openrouter_api_key_here
AI_INTEGRATIONS_OPENROUTER_MODEL_3=deepseek/deepseek-r1:free

# AI Slot 4 — Groq (10-30x faster inference, free tier)
# Get key at: console.groq.com (free account, no credit card)
GROQ_API_KEY=your_groq_api_key_here

# GitHub Token — REQUIRED for 5000 req/hr (vs 60 without it)
# Get at: github.com/settings/tokens — no scopes needed
GITHUB_TOKEN=your_github_personal_access_token_here

# Brave Search API — replaces DuckDuckGo for real web results
# Get at: api.search.brave.com (free: 2000 queries/month)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# NewsAPI — recent news and funding signals
# Get at: newsapi.org (free developer plan: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# Product Hunt API — find launched competitors
# Get at: producthunt.com/v2/oauth (free developer access)
PRODUCT_HUNT_API_KEY=your_product_hunt_api_key_here

# Brevo Email Service Configuration (Optional — falls back to console logging when not set)
# Required for sending team invitation emails and email verification to users.
# Get your API key from: https://app.brevo.com/settings/keys/api
# IMPORTANT: Use your verified sender email address in SMTP_FROM
# BREVO_API_KEY=your_brevo_api_key_here
# SMTP_FROM=Clariva <noreply@yourdomain.com>

# Frontend URL — used to build invitation links and verification links in emails.
# Must match the deployed frontend URL in production (e.g. Vercel URL).
# CRITICAL: Update this to your actual production URL when deploying!
FRONTEND_URL=http://localhost:5173
