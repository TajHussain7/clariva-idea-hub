# Database Configuration
# Replace with your PostgreSQL or Supabase connection string.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Port for the backend API server
PORT=3000

# Express Session Secret — use a strong random string in production
SESSION_SECRET=change-this-to-a-long-random-secret

# Allowed CORS Origins — comma-separated list of allowed frontend URLs
# In production: set this to your Vercel deployment URL
# e.g. CORS_ORIGIN=https://clariva-idea-hub-clariva-web.vercel.app
CORS_ORIGIN=http://localhost:5173

# Logging Level
LOG_LEVEL=info

# AI Integrations - OpenRouter Configuration
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback AI Slot 2 (uncomment and add key/model when needed)
# AI_INTEGRATIONS_OPENROUTER_API_KEY_2=
# AI_INTEGRATIONS_OPENROUTER_MODEL_2=google/gemma-3-27b-it:free

# Fallback AI Slot 3 (uncomment and add key/model when needed)
# AI_INTEGRATIONS_OPENROUTER_API_KEY_3=
# AI_INTEGRATIONS_OPENROUTER_MODEL_3=mistralai/mistral-7b-instruct:free

# GitHub API Token (Optional, for repository and code analysis features)
GITHUB_TOKEN=your_github_personal_access_token_here

# Brevo Email Service Configuration (Optional — falls back to console logging when not set)
# Required for sending team invitation emails to users.
# Get your API key from: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=your_brevo_api_key_here
# SMTP_FROM=Clariva <noreply@yourdomain.com>

# Frontend URL — used to build invitation links in emails.
# Must match the deployed frontend URL in production (e.g. Vercel URL).
FRONTEND_URL=http://localhost:5173
