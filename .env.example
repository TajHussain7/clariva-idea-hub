# Database Configuration
# Connect to your local PostgreSQL or Supabase PostgreSQL instance.
# For production (Render), use the transaction pooler connection string (port 6543).
# For local development/migrations, use the session/direct connection string (port 5432).
# Example: postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Node environment: "development" | "production"
NODE_ENV=development

# Port for the backend API server (defaults to 3000)
PORT=3000

# Express Session Secret - Use a long, randomly generated string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=local-development-secret-key-12345

# Allowed CORS Origins - Comma-separated list of frontend origins.
# In production set this to your Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://clariva.vercel.app
CORS_ORIGIN=http://localhost:5173

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# AI Integrations - OpenRouter Configuration (Multi-slot Fallback System)
# Standard base URL is https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary AI Slot (Slot 1)
AI_INTEGRATIONS_OPENROUTER_API_KEY=
# Optional model override (defaults to meta-llama/llama-3.3-70b-instruct:free)
# AI_INTEGRATIONS_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Fallback AI Slot 2 (Just add the key here to enable fallback slot 2)
# AI_INTEGRATIONS_OPENROUTER_API_KEY_2=
# Optional model override for slot 2 (defaults to google/gemma-3-27b-it:free)
# AI_INTEGRATIONS_OPENROUTER_MODEL_2=google/gemma-3-27b-it:free

# Fallback AI Slot 3 (Just add the key here to enable fallback slot 3)
# AI_INTEGRATIONS_OPENROUTER_API_KEY_3=
# Optional model override for slot 3 (defaults to mistralai/mistral-7b-instruct:free)
# AI_INTEGRATIONS_OPENROUTER_MODEL_3=mistralai/mistral-7b-instruct:free


# GitHub API Token (Optional, but strongly recommended to avoid rate limiting in production)
# Create a fine-grained token with read-only public repository access at:
# https://github.com/settings/tokens?type=beta
# GITHUB_TOKEN=

# --- FRONTEND (Vercel) Environment Variable ---
# Set this in the Vercel project dashboard, NOT in a committed .env file.
# Point this to your deployed Render backend URL.
# VITE_API_URL=https://clariva-api.onrender.com
